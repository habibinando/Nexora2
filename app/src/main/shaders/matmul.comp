#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BufferA { float A[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufferB { float B[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufferC { float C[]; };

layout(push_constant) uniform Dimensions {
    int M;
    int K;
    int N;
} dims;

shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    const uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    const uint col = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    const uint localRow = gl_LocalInvocationID.y;
    const uint localCol = gl_LocalInvocationID.x;

    float sum = 0.0;
    const uint tileCount = (uint(dims.K) + 15u) / 16u;

    for (uint tile = 0u; tile < tileCount; ++tile) {
        const uint kA = tile * 16u + localCol;
        const uint kB = tile * 16u + localRow;

        tileA[localRow][localCol] =
            (row < uint(dims.M) && kA < uint(dims.K))
                ? A[row * uint(dims.K) + kA] : 0.0;
        tileB[localRow][localCol] =
            (kB < uint(dims.K) && col < uint(dims.N))
                ? B[kB * uint(dims.N) + col] : 0.0;

        barrier();
        for (uint e = 0u; e < 16u; ++e) {
            sum += tileA[localRow][e] * tileB[e][localCol];
        }
        barrier();
    }

    if (row < uint(dims.M) && col < uint(dims.N)) {
        C[row * uint(dims.N) + col] = sum;
    }
}
